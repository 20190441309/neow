[flake8]
max-line-length = 88
extend-ignore = E203
exclude =
    .git,
    .venv,
    __pycache__,
    build,
    dist,
    docs
per-file-ignores =
    # main.py filters the urllib3/chardet mismatch warning *before* importing
    # anything that pulls in requests, so its imports sit below that call.
    neow/cli/main.py:E402

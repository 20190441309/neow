{
  "name": "neow-cli",
  "version": "0.1.2",
  "description": "Neow — A lightweight, full-featured AI coding agent for the terminal (TUI & CLI)",
  "license": "MIT",
  "bin": {
    "neow": "bin/neow.js",
    "neow-cli": "bin/neow.js"
  },
  "files": [
    "bin/neow.js",
    "neow/**/*.py",
    "neow/**/*.tcss",
    "pyproject.toml",
    "requirements.txt",

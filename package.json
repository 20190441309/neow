  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "tui",
    "llm",
    "developer-tools",
    "neow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/neow.git"
  }
}

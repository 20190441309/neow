
Screen {
    background: $neow-bg;
    color: $neow-text;
    layout: vertical;
}

#topbar {
    height: 1;
    background: $neow-surface;
    color: $neow-muted;
    padding: 0 1;
}

#topbar-info {
    width: 1fr;
}

#body {
    height: 1fr;
    layout: horizontal;
}

#timeline {
    width: 1fr;
    padding: 1 2;
}

#sidebar {
    width: 42;
    display: none;
    background: $neow-surface;
    border-left: solid $neow-border;
    padding: 1;
}

#sidebar.visible {
    display: block;
}

#queuestrip {
    display: none;
    height: auto;
    color: $neow-warn;
    padding: 0 1;
}

#queuestrip.visible {
    display: block;
}

#inputdock {
    height: auto;
    min-height: 2;
    max-height: 8;
    border-top: solid $neow-border;
    padding: 0 1;
}

#statusbar {
    height: 1;
    background: $neow-surface;
    color: $neow-muted;
    padding: 0 1;
}

ChatScreen.small-sidebar #sidebar {
    width: 36;
}

ChatScreen.no-sidebar #sidebar {
    display: none;
}

ChatScreen.narrow #timeline {
    padding: 0 1;
}

ChatScreen.narrow #inputdock {
    padding: 0;
}

ChatScreen.narrow #statusbar {
    padding: 0;
}

.picker-title {
    height: 1;
    color: $neow-accent2;
    text-style: bold;
    padding: 0 1;
}

#help-text {
    padding: 1 2;
}

#diff-body,
#cost-body {
    padding: 1 2;
    color: $neow-dim;
}
